{
  "name": "riic-knowledgeagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RIIC-KnowledgeAgent：明日方舟基建 RAG 知识库与 GLM/Qwen 查询 Agent 基准",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check:prose-terms": "node scripts/prose-terms-check.mjs",
    "check:reference-projection": "node scripts/tasks/knowledge/update-reference-projection.mjs --check",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "bench": "node dist/cli.js",
    "bench:dry": "pnpm run build && node dist/cli.js run --dry --limit 2"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "jieba-node": "^1.0.1"
  }
}
