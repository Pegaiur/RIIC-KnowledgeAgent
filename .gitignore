# 依赖与产物
node_modules/
dist/

# pnpm 内容寻址 store（仓库内本地缓存，不入库）
.pnpm-store/

# 密钥（本地 .env，不入库）
.env
.env.*
!.env.example
secret.yaml

# 基准运行结果（JSONL 原始记录，不入库）
bench-runs/

# 共享基准快照（由 bench export 生成，需显式 git add 入库）
!bench/results/
!bench/results/*.json

# 开发脚本临时区（runs/work，tooling tmp clean 管理；历史 cache 路径继续整体忽略）
dev-temp/

# 历史一次性脚本（不再由 tooling 生成或升迁，保留忽略以免暴露旧本地文件）
scripts/scratch/

# 测试产物
coverage/
test-results/
