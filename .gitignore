# 依赖与产物
node_modules/
dist/

# pnpm 内容寻址 store（仓库内本地缓存，不入库）
.pnpm-store/

# 密钥（本地 .env，不入库）
.env
.env.*
!.env.example
secret.yaml

# 基准运行结果（JSONL 原始记录，不入库）
bench-runs/

# 共享基准快照（由 bench export 生成，需显式 git add 入库）
!bench/results/
!bench/results/*.json

# 开发脚本临时区（runs/work/cache，tooling tmp clean 管理）
dev-temp/

# 一次性脚本（tooling new 生成，不入库）
scripts/scratch/

# 测试产物
coverage/
test-results/
